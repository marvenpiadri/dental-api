{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dontalist-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  // Per-environment, non-secret settings. Secrets (TIDB_DATABASE_URL, PASSWORD_PEPPER) are Worker secrets / .dev.vars, never here.
  // Private bucket for patient files (create it once: npx wrangler r2 bucket create dontalist-files). Never make it public.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dontalist-files" }],
  "vars": { "APP_ORIGIN": "https://dontalist.com", "API_ORIGIN": "https://api.dontalist.com" }
}
