{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dontalist-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  // `pg` needs the Node compatibility layer (docs/postgres-architecture.md §3).
  "compatibility_flags": ["nodejs_compat"],
  // Per-environment, non-secret settings. Secrets (PASSWORD_PEPPER, and DATABASE_URL for local dev) are Worker secrets / .dev.vars, never here.
  // The database is reached with a plain `pg` connection: DATABASE_URL (Neon POOLED host, runtime role) is a Worker secret. No Hyperdrive.
  // Files live in the PRIVATE R2 bucket "dontalist", reached through its S3 API with signed URLs (docs/r2-storage.md). Secrets (R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) and R2_ENDPOINT are set with `wrangler secret put`, never here.
  "vars": { "APP_ORIGIN": "https://app.dontalist.com", "API_ORIGIN": "https://api.dontalist.com", "R2_BUCKET": "dontalist" },
  "triggers": { "crons": ["17 * * * *"] }
}
