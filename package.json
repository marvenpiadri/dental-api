{
  "name": "dontalist-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "migrate": "node --env-file=.dev.vars tools/migrate.ts",
    "set-password": "node --env-file=.dev.vars tools/set-password.ts",
    "test:unit": "vitest run tests/*.unit.test.ts",
    "create-clinic": "node --env-file=.dev.vars tools/create-clinic.ts"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
