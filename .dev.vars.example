# Copy to .dev.vars (git-ignored). Never commit real values.
DATABASE_URL=postgres://USER:PASSWORD@HOST/dontalist
PASSWORD_PEPPER=change-me-long-random
APP_ORIGIN=http://localhost:4200
API_ORIGIN=http://localhost:8787
COOKIE_SECURE=false
# Cloudflare R2 (private bucket, S3 API). Create an API token with Object Read & Write on this bucket only.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=dontalist
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Password service (docs/password-service.md)
PASSWORD_SERVICE_URL=
PASSWORD_SERVICE_SECRET=
